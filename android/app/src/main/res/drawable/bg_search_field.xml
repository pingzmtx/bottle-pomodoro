<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索框底：圆角 10dp 卡片色 + 1dp 描边（深色模式下由 @color 自动跟随） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/settings_card" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/settings_divider" />
</shape>
