<?xml version="1.0" encoding="utf-8"?>
<!--
  二级页：应用多选。骨架 + 搜索框 + 列表容器 + 底部「完成」。
  列表行由 item_app_choice.xml inflate（含图标 / 名称 / 包名 / Switch / 选中竖条）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="10dp"
            android:text="‹ 返回"
            android:textColor="@color/settings_accent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/titleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/guard_apps_title"
            android:textColor="@color/settings_text"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 0.2.4（C）：白名单语义说明。常驻在顶部，因为"一个都不勾 = 全拦"这个默认
         如果用户不知道，会以为应用锁坏了。 -->
    <TextView
        android:id="@+id/allowHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="@string/guard_allow_hint"
        android:textColor="@color/settings_text_dim"
        android:textSize="12sp" />

    <!-- 搜索行：输入框 + 清空「✕」 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:hint="搜索应用名或包名"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/settings_text"
            android:textColorHint="@color/settings_text_dim"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/searchClear"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/settings_text_dim"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/countLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="2dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="@color/settings_text_dim"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_primary_button"
        android:text="完成"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />
</LinearLayout>
