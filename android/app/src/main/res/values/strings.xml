<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- label 用网页自己的品牌串，不另起名字 -->
    <string name="app_name">番茄专注·瓶子专注</string>

    <!-- 应用锁（无障碍服务）。
         文案里点名小米/华为/OPPO 的路径差异：这是唯一能兜住 ROM 差异的手段。
         硬编码各家设置页的 Activity 类名会随版本漂移，ActivityNotFoundException 概率极高（设计 A6）。 -->
    <string name="guard_service_label">应用锁（专注时拦截分心应用）</string>
    <string name="guard_service_desc">专注时把你打开的分心应用拉回桌面。只读取前台应用的包名，不读取任何窗口内容，不联网。</string>

    <!-- 原生设置页 -->
    <string name="settings_title">应用设置</string>
    <string name="guard_apps_title">选择要拦截的应用</string>

    <!-- 遮罩（全屏拦截页） -->
    <string name="guard_overlay_back">回到专注</string>
    <string name="guard_overlay_hint">专注中 · 长按此处 2 秒本场不再拦截</string>
</resources>
